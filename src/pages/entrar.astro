---
import Base from "../layouts/Base.astro";
const volver = Astro.url.searchParams.get("volver") ?? "/";
const destino = volver.startsWith("/") && !volver.startsWith("//") ? volver : "/";
const error = Astro.url.searchParams.get("error");
---
<Base title="Entrar · Claudio Herrera" description="Sitio personal de Claudio Herrera. Acceso con cuenta de Google.">
  <main class="contenedor entrar">
    <section class="caja vidrio">
      <span class="logo">Claudio <em>Herrera</em></span>
      <h1>Señal es un sitio <em>privado.</em></h1>
      <p class="lead">Proyectos, bitácora, ensayos y biblioteca. Para entrar, usa tu cuenta de Google.</p>
      {error && <p class="aviso mono">No se pudo entrar con esa cuenta. Prueba con otra cuenta de Google.</p>}
      <button class="google" id="entrar-google" data-destino={destino} type="button">
        <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Entrar con Google
      </button>
      <p class="mono muted nota">Solo uso tu nombre y tu correo para saber quién entra. No publico ni comparto nada.</p>
    </section>
  </main>
</Base>

<script>
  import { signIn } from "auth-astro/client";
  function enlazar() {
    const b = document.getElementById("entrar-google");
    if (!b || b.dataset.listo) return;
    b.dataset.listo = "1";
    b.addEventListener("click", () => signIn("google", { callbackUrl: b.dataset.destino || "/" }));
  }
  document.addEventListener("astro:page-load", enlazar);
</script>

<style>
  .entrar { min-height: 100vh; display: grid; place-items: center; padding-block: 48px; }
  .caja { max-width: 520px; width: 100%; padding: 36px 32px; display: grid; gap: 18px; }
  .logo { font-family: var(--display); font-size: 22px; }
  .logo em, h1 em { font-style: normal; color: var(--accent); }
  h1 { font-size: clamp(36px, 6vw, 52px); line-height: 1.02; }
  .lead { color: var(--fg-2); }
  .google { display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 14px 20px; border-radius: 999px; border: 1px solid var(--accent); background: var(--accent); color: var(--on-accent); font: 500 16px var(--body); cursor: pointer; transition: transform 0.2s; }
  .google svg { background: #fff; border-radius: 50%; padding: 2px; }
  .google:hover { transform: translateY(-1px); }
  .aviso { color: #ff9b9b; font-size: 13px; }
  .nota { font-size: 12px; }
</style>
