---
/* Barra horizontal fija del interior (diagramación A · Revista) con línea de progreso de lectura. */
import { nav } from "../data/sitio";
const actual = Astro.url.pathname.replace(/\/$/, "");
---
<header class="barra" transition:persist>
  <div class="contenedor fila">
    <a class="logo" href="/">Claudio <em>Herrera</em></a>
    <nav aria-label="Secciones">
      {nav.map((n) => (
        <a href={n.href} aria-current={actual === n.href || actual.startsWith(n.href + "/") ? "page" : undefined}>{n.nombre}</a>
      ))}
      {Astro.locals.usuario && <button class="salir" type="button" data-salir title={Astro.locals.usuario.email ?? ""}>Salir</button>}
    </nav>
  </div>
  <span class="progreso" aria-hidden="true"></span>
</header>

<script>
  import { signOut } from "auth-astro/client";
  document.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("[data-salir]");
    if (b) signOut({ callbackUrl: "/entrar" });
  });
</script>

<style>
  .barra {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .fila { display: flex; align-items: center; gap: 12px 28px; min-height: 60px; flex-wrap: wrap; padding-block: 8px; }
  .logo { font-family: var(--display); font-size: 22px; white-space: nowrap; }
  .logo em { font-style: normal; color: var(--accent); }
  nav { display: flex; gap: 20px; margin-left: auto; font-size: 15px; overflow-x: auto; scrollbar-width: none; }
  nav a { color: var(--fg-2); white-space: nowrap; padding-block: 4px; border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s; }
  nav a:hover, nav a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent); }
  .salir { color: var(--accent); background: none; border: 0; padding: 4px 0; font: inherit; cursor: pointer; }
  .progreso { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    .salir { color: var(--accent); background: none; border: 0; padding: 4px 0; font: inherit; cursor: pointer; }
  .progreso { animation: avance linear both; animation-timeline: scroll(root); }
    @keyframes avance { to { transform: scaleX(1); } }
  }
  @media (max-width: 700px) {
    nav { margin-left: 0; width: 100%; gap: 16px; font-size: 14px; }
  }
</style>
