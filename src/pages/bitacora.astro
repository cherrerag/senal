---
import Revista from "../layouts/Revista.astro";
import { cambios, hitos, ritmo } from "../data/sitio";
const meses = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const fecha = (iso: string) => { const [, m, d] = iso.split("-"); return `${+d} ${meses[+m - 1]}`; };
// Gráfico de ritmo: barras por semana ISO; desde la semana 30 (segundo cambio) en acento.
const W = 640, H = 220, base = 190, top = 24;
const max = Math.max(...ritmo.map(([, c]) => c));
const paso = W / ritmo.length;
const barras = ritmo.map(([s, c], i) => ({ s, c, x: i * paso + 2, w: paso - 4, h: c === 0 ? 0 : Math.max(3, (c / max) * (base - top)), despues: s >= 30 }));
const xCambio = barras.find((b) => b.s === 30)!.x - 2;
const antes = ritmo.filter(([s]) => s >= 23 && s <= 29).reduce((t, [, c]) => t + c, 0);
---
<Revista title="Bitácora" description="Cómo pasé de scripts sueltos a seis sistemas en 2026: los dos cambios, los hitos y el ritmo de commits semana a semana.">
  <header class="cabecera" transition:name="t-bitacora">
    <span class="eyebrow">Bitácora · marzo → noviembre 2026</span>
    <h1>Dos <em>cambios</em> en un año.</h1>
    <p class="lead">Entre marzo y octubre construí seis sistemas reales con 456 commits, sin ser desarrollador de oficio. Soy ingeniero electrónico con MBA y trabajo como Product Owner en telecomunicaciones. Lo hice <strong>dirigiendo agentes de IA como si fueran un equipo</strong>. Las fechas de esta página no vienen de la memoria: salen del historial de commits.</p>
  </header>

  <section class="sec">
    <div class="sec-k"><span class="num">01</span><span class="eyebrow">Los dos cambios</span></div>
    <div class="sec-c">
      <div class="cambios">
        {cambios.map((c) => (
          <article class="cambio vidrio aparece">
            <span class="mono acento">{fecha(c.fecha)} 2026</span>
            <h2>{c.titulo}</h2>
            <p>{c.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-k"><span class="num">02</span><span class="eyebrow">El ritmo</span></div>
    <div class="sec-c">
      <h2>Commits por semana, sumando todos los repositorios.</h2>
      <figure class="grafico vidrio">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="rt-t rt-d">
          <title id="rt-t">Commits por semana, de la semana 12 a la 43 de 2026</title>
          <desc id="rt-d">{`Entre las semanas 23 y 29 hubo ${antes} commits en total. En la semana 30 hubo 41; el máximo fue 95, en la semana 37.`}</desc>
          <line x1="0" x2={W} y1={base} y2={base} class="eje" />
          <line x1={xCambio} x2={xCambio} y1={top - 14} y2={base} class="marca" />
          <text x={xCambio - 8} y={top - 4} class="nota" text-anchor="end">25 jul · segundo cambio →</text>
          {barras.map((b) => (
            <g class:list={["b", { despues: b.despues }]}>
              <rect x={b.x - 2} y={top} width={b.w + 4} height={base - top} class="hit"><title>{`Semana ${b.s}: ${b.c} commits`}</title></rect>
              {b.h > 0 && <path d={`M${b.x} ${base} V${base - b.h + 3} q0 -3 3 -3 h${b.w - 6} q3 0 3 3 V${base} Z`} class="barra" />}
            </g>
          ))}
          <text x={barras[25].x + barras[25].w / 2} y={base - barras[25].h - 8} class="valor" text-anchor="middle">95</text>
          <text x={barras[18].x + barras[18].w / 2} y={base - barras[18].h - 8} class="valor" text-anchor="middle">41</text>
          {[["mar", 0], ["abr", 2], ["may", 6], ["jun", 11], ["jul", 15], ["ago", 19], ["sep", 24], ["oct", 28]].map(([m, i]) => <text x={barras[i as number].x} y={base + 22} class="eje-t">{m}</text>)}
        </svg>
        <figcaption class="mono muted">Suma de los seis repositorios del MacBook Pro M5. Semanas ISO 12 a 43. Pasa el cursor sobre una barra para ver su valor.</figcaption>
        <details class="tabla">
          <summary class="mono">Ver los datos</summary>
          <table><thead><tr><th>Semana</th><th>Commits</th></tr></thead><tbody>{ritmo.map(([s, c]) => <tr><td>{s}</td><td>{c}</td></tr>)}</tbody></table>
        </details>
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="sec-k"><span class="num">03</span><span class="eyebrow">Hitos</span></div>
    <div class="sec-c">
      <h2>Lo que pasó, en orden.</h2>
      <ol class="linea">
        {hitos.map((h) => (
          <li class:list={["aparece", { esCambio: h.cambio }]}>
            <span class="mono">{fecha(h.fecha)}</span>
            <div><h3>{h.titulo}</h3><p>{h.texto}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="sec-k"><span class="num">04</span><span class="eyebrow">Tres quiebres</span></div>
    <div class="sec-c">
      <h2>El método no se diseñó: <em>lo forzaron.</em></h2>
      <div class="tarjetas">
        <article class="tarjeta vidrio aparece"><span class="eyebrow">Julio</span><h3>De chats a documentos</h3><p>Los documentos de la sala decían «libre de deuda técnica» con la función principal muerta. Desde ahí, los documentos son el estado del proyecto.</p></article>
        <article class="tarjeta vidrio aparece"><span class="eyebrow">Septiembre</span><h3>De Notion a una base real</h3><p>Tres migraciones del catálogo y roturas silenciosas. Supabase pasó a ser la fuente única.</p></article>
        <article class="tarjeta vidrio aparece"><span class="eyebrow">Octubre</span><h3>De nueve repos a un sistema</h3><p>Con nueve repositorios activos el problema ya no era técnico, era de foco. Nació COCKPIT v2 como centro de mando único.</p></article>
      </div>
      <a class="siguiente vidrio" href="/metodo"><div><span class="eyebrow">Lo que quedó</span><h3>El método</h3></div><span class="boton">Leer →</span></a>
    </div>
  </section>
</Revista>

<style>
  .acento { color: var(--accent); }
  .cambios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .cambio { padding: 26px; display: grid; gap: 12px; align-content: start; border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  .cambio h2 { font-size: clamp(32px, 3.4vw, 44px); }
  .cambio p { color: var(--fg-2); }
  .grafico { margin: 0; padding: 22px; display: grid; gap: 12px; }
  .grafico svg { width: 100%; height: auto; overflow: visible; }
  .eje { stroke: var(--line); }
  .eje-t { font-family: var(--mono); font-size: 11px; fill: var(--fg-2); }
  .marca { stroke: var(--accent); stroke-dasharray: 3 4; opacity: 0.7; }
  .nota { font-family: var(--mono); font-size: 11px; fill: var(--accent); }
  .valor { font-family: var(--mono); font-size: 12px; fill: var(--fg); }
  .barra { fill: color-mix(in srgb, var(--fg-2) 55%, transparent); transition: fill 0.2s; }
  .despues .barra { fill: var(--accent); }
  .hit { fill: transparent; }
  .b:hover .barra { fill: var(--fg); }
  .tabla summary { cursor: pointer; color: var(--accent); width: fit-content; }
  .tabla table { margin-top: 10px; border-collapse: collapse; font-family: var(--mono); font-size: 12.5px; columns: 2; }
  .tabla td, .tabla th { padding: 3px 18px 3px 0; text-align: left; border-bottom: 1px solid var(--line); }
  .linea { list-style: none; margin: 0; padding: 0; display: grid; }
  .linea li { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 20px; padding-block: 20px; border-top: 1px solid var(--line); }
  .linea .mono { color: var(--fg-2); padding-top: 6px; }
  .linea h3 { font-size: 26px; line-height: 1.15; }
  .linea p { color: var(--fg-2); margin-top: 4px; }
  .linea .esCambio .mono, .linea .esCambio h3 { color: var(--accent); }
  @media (max-width: 760px) {
    .cambios { grid-template-columns: minmax(0, 1fr); }
    .linea li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .grafico { padding: 14px; }
  }
</style>
